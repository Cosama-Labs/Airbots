{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airbots.dev/spec/0.2/verification-record.schema.json",
  "title": "AIRbot Verification Record Draft 0.2",
  "type": "object",
  "additionalProperties": true,
  "required": ["airbot_id", "version", "package_digest", "profile", "status", "verified_at", "verifier"],
  "properties": {
    "airbot_id": { "type": "string" },
    "version": { "type": "string" },
    "package_digest": { "type": "string", "pattern": "^sha256:.+$" },
    "profile": { "type": "string" },
    "status": { "enum": ["verified", "failed", "expired", "revoked"] },
    "verified_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "verifier": { "type": "object" },
    "checks": { "type": "array" },
    "badge_uri": { "type": "string" }
  }
}
